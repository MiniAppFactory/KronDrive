<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sadece reklamlar icin. Oyunun kendisi tamamen cevrimdisi calisir. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KronDrive">

        <!-- PLACEHOLDER: Google'in herkese acik TEST App ID'si.
             Yayin oncesi AdMob konsolunda olusturulan GERCEK App ID ile
             degistirilmeli (bkz. docs/ADMOB_SETUP.md). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Oyun dikey (portrait) tasarlandi: HTML prototipteki yol/serit
             duzeni, HUD ve kontrol yerlesimi dikey ekrana gore olculuyor.
             configChanges: Activity yeniden yaratilmadan boyut/klavye
             degisimleri yonetilir — devam eden bir kosunun bellek-ici
             durumu (GameEngine) korunur. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KronDrive"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
