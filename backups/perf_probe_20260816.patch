@@ -0,0 +1,108 @@
+package com.miniappfactory.krondrive.game
+
+import com.miniappfactory.krondrive.data.BoosterType
+import org.junit.Test
+import kotlin.random.Random
+
+/**
+ * GECICI OLCUM DOSYASI — 2026-08-16 performans olcumu icin.
+ * Olcum bitince SILINIR. Assert yok, yalnizca stdout raporu.
+ *
+ * Yalnizca RUNNING fazindaki kareler sayilir; kosu carpinca yeni motor kurulur
+ * (kurulum suresi olcume GIRMEZ).
+ */
+class TempEngineStepBenchTest {
+
+    private var seedCounter = 0
+
+    private fun newRunningEngine(): GameEngine {
+        val e = GameEngine(
+            mode = RunMode.ENDLESS,
+            level = null,
+            upgrades = UpgradeLevels(),
+            boosters = emptySet<BoosterType>(),
+            endlessRecordSeconds = 0,
+            carStyle = CarStyle(CarCatalog.defaultShape, CarCatalog.defaultColor),
+            random = Random(4000 + seedCounter++)
+        )
+        e.setViewport(360f, 740f)
+        var guard = 0
+        while (e.phase == RunPhase.COUNTDOWN && guard++ < 1000) e.step(1f / 60f)
+        return e
+    }
+
+    /**
+     * [targetFrames] kadar RUNNING karesi olcer. Carpma olunca saat DURDURULUP
+     * yeni motor kurulur. Donen: (toplam ns, sayilan kare, en son sahne durumu).
+     */
+    private fun measure(targetFrames: Int, boost: Boolean, steerEveryN: Int): Triple<Long, Int, String> {
+        val dt = 1f / 60f
+        var engine = newRunningEngine()
+        engine.setBoost(boost)
+        var counted = 0
+        var totalNs = 0L
+        var lastState = ""
+        var i = 0
+        while (counted < targetFrames) {
+            if (engine.phase != RunPhase.RUNNING) {
+                lastState = "obstacles=${engine.obstacles.size} coins=${engine.coins.size} " +
+                    "particles=${engine.particles.size}"
+                engine = newRunningEngine()
+                engine.setBoost(boost)
+                i = 0
+                continue
+            }
+            // Gercekci girdi: belirli araliklarla serit degistir.
+            if (steerEveryN > 0 && i % steerEveryN == 0) {
+                if ((i / steerEveryN) % 2 == 0) engine.steerLeft() else engine.steerRight()
+            }
+            val t0 = System.nanoTime()
+            engine.step(dt)
+            val t1 = System.nanoTime()
+            totalNs += (t1 - t0)
+            counted++
+            i++
+        }
+        if (lastState.isEmpty()) {
+            lastState = "obstacles=${engine.obstacles.size} coins=${engine.coins.size} " +
+                "particles=${engine.particles.size}"
+        }
+        return Triple(totalNs, counted, lastState)
+    }
+
+    @Test
+    fun benchStep() {
+        println("[BENCH] JVM=" + System.getProperty("java.version") + " os=" + System.getProperty("os.name"))
+        // Isinma (JIT)
+        measure(50_000, boost = false, steerEveryN = 30)
+        measure(50_000, boost = true, steerEveryN = 30)
+
+        for ((label, boost) in listOf("no-boost" to false, "boost-held" to true)) {
+            val runs = DoubleArray(7)
+            var lastState = ""
+            for (r in runs.indices) {
+                val (ns, frames, state) = measure(30_000, boost = boost, steerEveryN = 30)
+                runs[r] = ns.toDouble() / frames
+                lastState = state
+            }
+            runs.sort()
+            println(
+                "[BENCH] %-12s median=%.0f ns/step  min=%.0f  max=%.0f  (7 kosu x 30000 RUNNING kare)  son sahne: %s"
+                    .format(label, runs[runs.size / 2], runs.first(), runs.last(), lastState)
+            )
+        }
+
+        // Tahsisat: uzun bir kosuda toplam heap artisi / kare.
+        val rt = Runtime.getRuntime()
+        for ((label, boost) in listOf("no-boost" to false, "boost-held" to true)) {
+            System.gc(); Thread.sleep(80); System.gc(); Thread.sleep(80)
+            val before = rt.totalMemory() - rt.freeMemory()
+            val (_, frames, _) = measure(200_000, boost = boost, steerEveryN = 30)
+            val after = rt.totalMemory() - rt.freeMemory()
+            println(
+                "[BENCH] alloc %-12s net heap delta=%d B over %d frames (GC'siz olculmedi; kaba ust sinir)"
+                    .format(label, after - before, frames)
+            )
+        }
+    }
+}
