+package com.miniappfactory.krondrive.game
+
+/**
+ * GECICI OLCUM ARACI — 2026-08-16 performans olcumu. Olcum bitince SILINIR.
+ *
+ * Tek bir APK ile hem temayi sabitlemeyi hem de sahne katmanlarini tek tek
+ * kapatmayi (ablasyon) saglar; boylece her varyant icin yeniden derleme
+ * gerekmez. Degerler MainActivity'de Intent ekstralarindan okunur:
+ *
+ *   am start -n <pkg>/.MainActivity --ei perftheme 2 --ei perfmask 63
+ */
+object PerfProbe {
+    /** -1 = rastgele (uretim davranisi). 0..3 = RoadTheme sirasi. */
+    @JvmStatic
+    var forcedTheme: Int = -1
+
+    /** Bit maskesi; -1 = hepsi acik. */
+    @JvmStatic
+    var mask: Int = -1
+
+    const val BIT_SIDE_BASE = 0      // yol kenari zemin dikdortgenleri
+    const val BIT_SIDE_DECOR = 1     // seyirci / sehir isiklari / cizgiler / bayraklar
+    const val BIT_ROAD_BASE = 2      // asfalt dikdortgeni
+    const val BIT_ROAD_DECOR = 3     // kerb + serit cizgileri + noktalar
+    const val BIT_ACTORS = 4         // oyuncu + trafik + coin + parcacik + far
+    const val BIT_GAUGE = 5          // hiz gostergesi
+
+    fun on(bit: Int): Boolean = (mask shr bit) and 1 == 1
+}
